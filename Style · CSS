/* ==========================================================================
   Instituto Restauração — Design tokens
   Palette drawn from the mark: deep navy + warm gold, on warm paper.
   Display: Fraunces (warmth, human, editorial)  |  Body: Inter (clarity)
   Signature motif: the sprouting seedling from the logo, redrawn as a line
   icon that "grows" (stroke draws in) as it enters the viewport.
   ========================================================================== */

:root{
  --navy-950:#0A1730;
  --navy-900:#0F1F42;
  --navy-800:#152A56;
  --navy-700:#1F3873;
  --navy-600:#2C4A94;
  --gold-600:#A67F2E;
  --gold-500:#C9A24B;
  --gold-300:#E4CD8C;
  --gold-100:#F3E7C8;
  --cream:#F6F1E6;
  --paper:#FFFDF9;
  --ink:#1B2333;
  --ink-soft:#5B6377;
  --line:#E3DAC4;
  --line-dark:rgba(255,255,255,.14);

  --font-display:'Fraunces', Georgia, serif;
  --font-body:'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

  --container:1160px;
  --radius:14px;
  --ease:cubic-bezier(.22,.61,.36,1);
}

*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  font-family:var(--font-body);
  color:var(--ink);
  background:var(--paper);
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
ul{margin:0;padding:0;list-style:none;}
h1,h2,h3,h4{font-family:var(--font-display);margin:0;font-weight:600;color:var(--navy-900);}
p{margin:0;}
.container{max-width:var(--container);margin:0 auto;padding:0 28px;}

/* Focus visibility */
a:focus-visible,button:focus-visible{outline:2px solid var(--gold-600);outline-offset:3px;}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important;scroll-behavior:auto !important;}
}

/* ---------- Eyebrow / labels ---------- */
.eyebrow{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--font-body);
  font-size:.78rem;letter-spacing:.16em;text-transform:uppercase;
  font-weight:600;color:var(--gold-600);
}
.eyebrow::before{content:"";width:22px;height:1px;background:var(--gold-500);display:inline-block;}

/* ---------- Header / nav ---------- */
.site-header{
  position:sticky;top:0;z-index:50;
  background:rgba(10,23,48,.92);
  backdrop-filter:saturate(140%) blur(8px);
  border-bottom:1px solid var(--line-dark);
}
.nav{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 28px;max-width:var(--container);margin:0 auto;
}
.brand{display:flex;align-items:center;gap:12px;}
.brand img{width:38px;height:38px;object-fit:contain;}
.brand-name{
  font-family:var(--font-display);color:#fff;font-weight:600;
  font-size:1.05rem;line-height:1.1;letter-spacing:.01em;
}
.brand-name small{display:block;font-family:var(--font-body);font-weight:400;
  font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold-300);margin-top:2px;}

.nav-links{display:flex;gap:2px;align-items:center;}
.nav-links a{
  color:rgba(255,255,255,.82);font-size:.92rem;font-weight:500;
  padding:9px 15px;border-radius:999px;transition:background .25s var(--ease), color .25s var(--ease);
}
.nav-links a:hover{background:rgba(255,255,255,.08);color:#fff;}
.nav-links a.active{color:var(--navy-900);background:var(--gold-500);}

.nav-cta{
  margin-left:8px;padding:9px 18px;border-radius:999px;
  background:var(--gold-500);color:var(--navy-950);font-weight:700;font-size:.88rem;
  transition:transform .2s var(--ease), background .2s var(--ease);
}
.nav-cta:hover{background:var(--gold-300);transform:translateY(-1px);}

.nav-toggle{display:none;background:none;border:0;color:#fff;font-size:1.5rem;cursor:pointer;}

@media (max-width:860px){
  .nav-links{
    position:absolute;top:100%;left:0;right:0;
    background:var(--navy-950);flex-direction:column;align-items:stretch;
    padding:8px 20px 18px;gap:2px;
    max-height:0;overflow:hidden;transition:max-height .35s var(--ease);
  }
  .nav-links.open{max-height:420px;}
  .nav-links a{padding:12px 10px;border-radius:8px;}
  .nav-cta{margin:8px 10px 0;text-align:center;}
  .nav-toggle{display:block;}
}

/* ---------- Hero ---------- */
.hero{
  position:relative;overflow:hidden;
  background:radial-gradient(120% 140% at 82% -10%, var(--navy-700) 0%, var(--navy-900) 45%, var(--navy-950) 100%);
  color:#fff;padding:96px 0 120px;
}
.hero-rings{
  position:absolute;right:-140px;top:-120px;width:640px;height:640px;
  border-radius:50%;border:1px solid var(--line-dark);pointer-events:none;
}
.hero-rings::before,.hero-rings::after{
  content:"";position:absolute;border-radius:50%;border:1px solid var(--line-dark);
}
.hero-rings::before{inset:70px;}
.hero-rings::after{inset:150px;border-color:rgba(201,162,75,.28);}

.hero-inner{
  position:relative;z-index:2;
  display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center;
}
.hero h1{
  font-size:clamp(2.3rem,4.6vw,3.6rem);color:#fff;line-height:1.08;letter-spacing:-.01em;
}
.hero h1 em{font-style:italic;color:var(--gold-300);font-weight:300;}
.hero-lead{
  margin-top:22px;font-size:1.12rem;color:rgba(255,255,255,.82);max-width:46ch;
}
.hero-actions{display:flex;gap:14px;margin-top:34px;flex-wrap:wrap;}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:14px 26px;border-radius:999px;font-weight:700;font-size:.95rem;
  transition:transform .2s var(--ease), box-shadow .2s var(--ease), background .2s var(--ease);
  border:1px solid transparent;cursor:pointer;
}
.btn-primary{background:var(--gold-500);color:var(--navy-950);}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 28px -12px rgba(201,162,75,.6);background:var(--gold-300);}
.btn-ghost{border-color:rgba(255,255,255,.35);color:#fff;}
.btn-ghost:hover{border-color:#fff;background:rgba(255,255,255,.08);}
.btn-dark{background:var(--navy-900);color:#fff;}
.btn-dark:hover{background:var(--navy-800);transform:translateY(-2px);}

.hero-stats{display:flex;gap:34px;margin-top:52px;flex-wrap:wrap;}
.hero-stats div strong{display:block;font-family:var(--font-display);font-size:1.9rem;color:var(--gold-300);}
.hero-stats div span{font-size:.82rem;color:rgba(255,255,255,.68);}

.hero-emblem{
  position:relative;justify-self:center;
  width:min(340px,80%);aspect-ratio:1;
  display:flex;align-items:center;justify-content:center;
}
.hero-emblem img{
  width:100%;filter:drop-shadow(0 30px 60px rgba(0,0,0,.45));
  animation:float 7s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}

/* ---------- Section scaffolding ---------- */
section{padding:104px 0;}
.section-cream{background:var(--cream);}
.section-head{max-width:640px;margin-bottom:56px;}
.section-head h2{font-size:clamp(1.8rem,3vw,2.5rem);margin-top:14px;line-height:1.15;}
.section-head p{margin-top:16px;color:var(--ink-soft);font-size:1.05rem;}
.section-head.center{margin-left:auto;margin-right:auto;text-align:center;}

/* ---------- Growth divider (signature element) ---------- */
.grow-divider{display:flex;align-items:center;justify-content:center;gap:16px;margin:0 auto 48px;}
.grow-divider .line{height:1px;width:64px;background:var(--line);}
.grow-divider svg{width:34px;height:34px;}
.grow-divider path{
  fill:none;stroke:var(--gold-600);stroke-width:5;stroke-linecap:round;stroke-linejoin:round;
  stroke-dasharray:220;stroke-dashoffset:220;transition:stroke-dashoffset 1.4s var(--ease);
}
.grow-divider.in-view path{stroke-dashoffset:0;}

/* ---------- Mission / Vision / Values ---------- */
.pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;}
.pillar{
  background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);
  padding:34px 30px;position:relative;overflow:hidden;
  transition:transform .3s var(--ease), box-shadow .3s var(--ease);
}
.pillar:hover{transform:translateY(-6px);box-shadow:0 24px 40px -24px rgba(15,31,66,.25);}
.pillar .num{
  font-family:var(--font-display);font-size:.85rem;color:var(--gold-600);
  letter-spacing:.08em;text-transform:uppercase;font-weight:600;
}
.pillar h3{margin-top:14px;font-size:1.35rem;}
.pillar p{margin-top:12px;color:var(--ink-soft);font-size:.98rem;}

/* ---------- Values chips ---------- */
.values-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:22px;}
.value-chip{
  border:1px solid var(--line);background:var(--paper);
  padding:9px 18px;border-radius:999px;font-size:.9rem;color:var(--navy-800);font-weight:600;
}

/* ---------- Services grid ---------- */
.services-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.service-card{
  background:var(--navy-900);color:#fff;border-radius:var(--radius);
  padding:28px 22px;position:relative;overflow:hidden;
  transition:transform .3s var(--ease), background .3s var(--ease);
}
.service-card:hover{transform:translateY(-6px);background:var(--navy-800);}
.service-card .icon{
  width:46px;height:46px;border-radius:50%;background:rgba(201,162,75,.16);
  display:flex;align-items:center;justify-content:center;margin-bottom:18px;
  color:var(--gold-300);font-size:1.3rem;
}
.service-card .n{font-size:.72rem;color:var(--gold-300);letter-spacing:.1em;font-weight:700;}
.service-card h4{color:#fff;font-size:1.08rem;margin-top:6px;font-weight:600;font-family:var(--font-body);}
.service-card p{color:rgba(255,255,255,.62);font-size:.86rem;margin-top:8px;}

/* ---------- Impact band ---------- */
.impact{
  background:var(--navy-950);color:#fff;padding:80px 0;
  background-image:radial-gradient(60% 120% at 10% 20%, rgba(201,162,75,.12), transparent 60%);
}
.impact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;text-align:center;}
.impact-grid strong{font-family:var(--font-display);font-size:2.4rem;color:var(--gold-300);display:block;}
.impact-grid span{font-size:.85rem;color:rgba(255,255,255,.68);}

/* ---------- Blog preview / cards ---------- */
.post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;}
.post-card{
  border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:var(--paper);
  transition:transform .3s var(--ease), box-shadow .3s var(--ease);
}
.post-card:hover{transform:translateY(-6px);box-shadow:0 24px 40px -24px rgba(15,31,66,.22);}
.post-thumb{
  height:150px;background:linear-gradient(135deg,var(--navy-800),var(--navy-600));
  display:flex;align-items:center;justify-content:center;
}
.post-thumb svg{width:44px;height:44px;stroke:var(--gold-300);}
.post-body{padding:22px 22px 26px;}
.post-date{font-size:.76rem;color:var(--gold-600);font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
.post-body h3{margin-top:10px;font-size:1.15rem;line-height:1.3;}
.post-body p{margin-top:10px;color:var(--ink-soft);font-size:.92rem;}
.post-link{display:inline-block;margin-top:14px;font-weight:700;color:var(--navy-800);font-size:.88rem;}
.post-link::after{content:" →";}

/* ---------- CTA band ---------- */
.cta-band{
  background:var(--gold-100);border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  padding:70px 0;
}
.cta-inner{display:flex;align-items:center;justify-content:space-between;gap:30px;flex-wrap:wrap;}
.cta-inner h2{font-size:1.7rem;max-width:36ch;}
.cta-inner p{color:var(--ink-soft);margin-top:10px;}

/* ---------- Footer ---------- */
.site-footer{background:var(--navy-950);color:rgba(255,255,255,.72);padding:70px 0 30px;}
.footer-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:40px;}
.footer-brand{display:flex;align-items:center;gap:12px;margin-bottom:16px;}
.footer-brand img{width:34px;}
.footer-brand span{font-family:var(--font-display);color:#fff;font-size:1.05rem;}
.footer-col h5{color:#fff;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;margin-bottom:16px;font-family:var(--font-body);font-weight:700;}
.footer-col li{margin-bottom:10px;font-size:.92rem;}
.footer-col a:hover{color:var(--gold-300);}
.footer-bottom{
  margin-top:56px;padding-top:24px;border-top:1px solid var(--line-dark);
  display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:.82rem;color:rgba(255,255,255,.5);
}

/* ---------- Page hero (inner pages) ---------- */
.page-hero{
  background:linear-gradient(160deg,var(--navy-900),var(--navy-950));
  color:#fff;padding:70px 0 60px;
}
.page-hero h1{color:#fff;font-size:clamp(2rem,4vw,2.8rem);}
.page-hero p{margin-top:14px;color:rgba(255,255,255,.75);max-width:60ch;}
.breadcrumb{font-size:.82rem;color:var(--gold-300);margin-bottom:16px;letter-spacing:.04em;}

/* ---------- Content blocks (sobre / contato) ---------- */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;}
.contact-card{
  background:var(--navy-950);color:#fff;border-radius:var(--radius);padding:36px;
}
.contact-card h3{color:#fff;font-size:1.2rem;}
.contact-row{display:flex;gap:14px;margin-top:22px;align-items:flex-start;}
.contact-row .ic{
  width:36px;height:36px;border-radius:50%;background:rgba(201,162,75,.18);color:var(--gold-300);
  display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1rem;
}
.contact-row div p{color:rgba(255,255,255,.78);font-size:.92rem;}
.contact-row div span{display:block;font-size:.76rem;color:var(--gold-300);letter-spacing:.06em;text-transform:uppercase;font-weight:700;margin-bottom:2px;}

.form-field{margin-bottom:18px;}
.form-field label{display:block;font-size:.85rem;font-weight:600;color:var(--navy-800);margin-bottom:6px;}
.form-field input,.form-field textarea{
  width:100%;padding:13px 14px;border-radius:10px;border:1px solid var(--line);
  font-family:var(--font-body);font-size:.95rem;background:var(--paper);color:var(--ink);
}
.form-field textarea{min-height:120px;resize:vertical;}
.form-field input:focus,.form-field textarea:focus{outline:2px solid var(--gold-500);outline-offset:1px;}

/* ---------- Reveal on scroll ---------- */
.reveal{opacity:0;transform:translateY(22px);transition:opacity .7s var(--ease), transform .7s var(--ease);}
.reveal.in-view{opacity:1;transform:translateY(0);}

/* ---------- Timeline (história) ---------- */
.timeline{border-left:2px solid var(--line);padding-left:30px;margin-top:10px;}
.tl-item{position:relative;padding-bottom:36px;}
.tl-item::before{
  content:"";position:absolute;left:-37px;top:4px;width:12px;height:12px;border-radius:50%;
  background:var(--gold-500);border:3px solid var(--paper);box-shadow:0 0 0 2px var(--gold-500);
}
.tl-item h4{font-size:1rem;color:var(--navy-900);}
.tl-item span{font-size:.78rem;color:var(--gold-600);font-weight:700;letter-spacing:.06em;text-transform:uppercase;}
.tl-item p{margin-top:6px;color:var(--ink-soft);font-size:.92rem;}

/* ---------- Responsive ---------- */
@media (max-width:980px){
  .hero-inner{grid-template-columns:1fr;text-align:left;}
  .hero-emblem{order:-1;width:220px;margin-bottom:10px;}
  .hero-stats{gap:24px;}
  .pillars{grid-template-columns:1fr;}
  .services-grid{grid-template-columns:repeat(2,1fr);}
  .impact-grid{grid-template-columns:repeat(2,1fr);gap:26px;}
  .post-grid{grid-template-columns:1fr;}
  .two-col{grid-template-columns:1fr;gap:40px;}
  .footer-grid{grid-template-columns:1fr 1fr;}
}
@media (max-width:520px){
  section{padding:72px 0;}
  .services-grid{grid-template-columns:1fr;}
  .impact-grid{grid-template-columns:1fr 1fr;}
  .cta-inner{flex-direction:column;align-items:flex-start;}
  .footer-grid{grid-template-columns:1fr;}
}
